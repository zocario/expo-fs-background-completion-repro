From 11174e554ed787778de8cd541a31b1d692d8b13c Mon Sep 17 00:00:00 2001
From: Enzo Chiaro <enzo@there.do>
Date: Fri, 13 Nov 2026 10:17:53 +0100
Subject: [PATCH] [ios][file-system] Complete background session events that
 expo-file-system does not hold

ExpoAppDelegateSubscriberManager calls the system completion handler of
application(_:handleEventsForBackgroundURLSession:completionHandler:) only after every
subscriber calls its own handler. expo-file-system has two subscribers that keep the handler:

- The legacy EXSessionHandler singleton, reached through EXLegacyAppDelegateWrapper, stores
  every handler. Since the Swift FileSystemBackgroundSessionHandler replaced it, nothing
  calls the stored handlers.
- FileSystemBackgroundSessionHandler waits for URLSession's final event, which it only
  receives for its own sessions.

EXSessionHandler now completes at once. FileSystemBackgroundSessionHandler keeps waiting only
for its own sessions: the new API's background session and the legacy sessions created in this
process. It completes at once for any other session.
---
 ...e-system-ios-foreign-background-session.md |  5 +++
 .../ios/FileSystemDownloadTask.swift          |  2 +-
 .../Legacy/EXSessionTasks/EXSessionHandler.m  |  4 ++-
 .../FileSystemBackgroundSessionHandler.swift  | 26 +++++++++++++++
 .../ios/Legacy/FileSystemLegacyModule.swift   |  9 ++++-
 ...t_FileSystemBackgroundSessionHandler.swift | 33 +++++++++++++++++++
 6 files changed, 76 insertions(+), 3 deletions(-)
 create mode 100644 .changeset/file-system-ios-foreign-background-session.md
 create mode 100644 packages/expo-file-system/ios/Tests/test_FileSystemBackgroundSessionHandler.swift

diff --git a/.changeset/file-system-ios-foreign-background-session.md b/.changeset/file-system-ios-foreign-background-session.md
new file mode 100644
index 00000000000..1961e0dac6f
--- /dev/null
+++ b/.changeset/file-system-ios-foreign-background-session.md
@@ -0,0 +1,5 @@
+---
+'expo-file-system': patch
+---
+
+[iOS] Fix the app never calling the system completion handler of `handleEventsForBackgroundURLSession`, for `expo-file-system` background downloads and for background sessions of other modules.
diff --git a/packages/expo-file-system/ios/FileSystemDownloadTask.swift b/packages/expo-file-system/ios/FileSystemDownloadTask.swift
index 271d4ce7b65..ac29dca23c3 100644
--- a/packages/expo-file-system/ios/FileSystemDownloadTask.swift
+++ b/packages/expo-file-system/ios/FileSystemDownloadTask.swift
@@ -221,7 +221,7 @@ final class NetworkTaskSessionManager {
     return URLSession(configuration: configuration, delegate: dispatcher, delegateQueue: .main)
   }
 
-  private static let backgroundSessionIdentifier = {
+  static let backgroundSessionIdentifier = {
     let bundleIdentifier = Bundle.main.bundleIdentifier ?? "expo.modules.filesystem"
     return "\(bundleIdentifier).expo-file-system.network-task.background"
   }()
diff --git a/packages/expo-file-system/ios/Legacy/EXSessionTasks/EXSessionHandler.m b/packages/expo-file-system/ios/Legacy/EXSessionTasks/EXSessionHandler.m
index 8b1e4261d21..9642f52f2c4 100644
--- a/packages/expo-file-system/ios/Legacy/EXSessionTasks/EXSessionHandler.m
+++ b/packages/expo-file-system/ios/Legacy/EXSessionTasks/EXSessionHandler.m
@@ -43,7 +43,9 @@ - (void)invokeCompletionHandlerForSessionIdentifier:(NSString *)identifier
 
 - (void)application:(UIApplication *)application handleEventsForBackgroundURLSession:(NSString *)identifier completionHandler:(void (^)(void))completionHandler
 {
-  _completionHandlers[identifier] = completionHandler;
+  // FileSystemBackgroundSessionHandler handles background sessions. EXLegacyAppDelegateWrapper still
+  // forwards this event to this singleton module and waits for it, so complete at once.
+  completionHandler();
 }
 
 @end
diff --git a/packages/expo-file-system/ios/Legacy/FileSystemBackgroundSessionHandler.swift b/packages/expo-file-system/ios/Legacy/FileSystemBackgroundSessionHandler.swift
index 74fae4fd0f0..797e1b20c4e 100644
--- a/packages/expo-file-system/ios/Legacy/FileSystemBackgroundSessionHandler.swift
+++ b/packages/expo-file-system/ios/Legacy/FileSystemBackgroundSessionHandler.swift
@@ -8,6 +8,26 @@ public final class FileSystemBackgroundSessionHandler: ExpoAppDelegateSubscriber
   // Bounds event delivery plus JS processing; completion still waits for URLSession's final event.
   private static let backgroundCompletionTimeout: TimeInterval = 25
   private let completion = BackgroundSessionCompletion()
+  // Legacy background sessions have random identifiers, so they are registered when created.
+  private let legacySessionsLock = NSLock()
+  private var legacySessionIdentifiers: Set<String> = []
+
+  func registerLegacySession(_ identifier: String) {
+    legacySessionsLock.lock()
+    defer { legacySessionsLock.unlock() }
+    legacySessionIdentifiers.insert(identifier)
+  }
+
+  private func ownsSession(_ identifier: String) -> Bool {
+    #if os(iOS)
+    if identifier == NetworkTaskSessionManager.backgroundSessionIdentifier {
+      return true
+    }
+    #endif
+    legacySessionsLock.lock()
+    defer { legacySessionsLock.unlock() }
+    return legacySessionIdentifiers.contains(identifier)
+  }
 
   func registerDownload(_ task: FileSystemDownloadTask, forSessionIdentifier identifier: String) {
     completion.register(task, session: identifier)
@@ -35,6 +55,12 @@ public final class FileSystemBackgroundSessionHandler: ExpoAppDelegateSubscriber
 
   #if os(iOS) || os(tvOS)
   public func application(_ application: UIApplication, handleEventsForBackgroundURLSession identifier: String, completionHandler: @escaping () -> Void) {
+    // Expo calls the system handler only once every subscriber has called its own, and this module
+    // never receives the final event of a session it did not create, so answer for those at once.
+    guard ownsSession(identifier) else {
+      completionHandler()
+      return
+    }
     let token = completion.receiveHandler(identifier, completion: completionHandler)
     DispatchQueue.main.asyncAfter(deadline: .now() + Self.backgroundCompletionTimeout) { [weak self] in
       self?.completion.expire(identifier, token: token)
diff --git a/packages/expo-file-system/ios/Legacy/FileSystemLegacyModule.swift b/packages/expo-file-system/ios/Legacy/FileSystemLegacyModule.swift
index 0db6a3f9c25..0ffb4a77c70 100644
--- a/packages/expo-file-system/ios/Legacy/FileSystemLegacyModule.swift
+++ b/packages/expo-file-system/ios/Legacy/FileSystemLegacyModule.swift
@@ -11,7 +11,14 @@ public final class FileSystemLegacyModule: Module {
   private lazy var taskHandlersManager = EXTaskHandlersManager()
   private lazy var resourceManager = PHAssetResourceManager()
 
-  private lazy var backgroundSession = createUrlSession(type: .background, delegate: sessionTaskDispatcher)
+  private lazy var backgroundSession: URLSession = {
+    let session = createUrlSession(type: .background, delegate: sessionTaskDispatcher)
+    if let identifier = session.configuration.identifier {
+      ExpoAppDelegateSubscriberRepository.getSubscriberOfType(FileSystemBackgroundSessionHandler.self)?
+        .registerLegacySession(identifier)
+    }
+    return session
+  }()
   private lazy var foregroundSession = createUrlSession(type: .foreground, delegate: sessionTaskDispatcher)
 
   private var documentDirectory: URL? {
diff --git a/packages/expo-file-system/ios/Tests/test_FileSystemBackgroundSessionHandler.swift b/packages/expo-file-system/ios/Tests/test_FileSystemBackgroundSessionHandler.swift
new file mode 100644
index 00000000000..d38035ade10
--- /dev/null
+++ b/packages/expo-file-system/ios/Tests/test_FileSystemBackgroundSessionHandler.swift
@@ -0,0 +1,33 @@
+// Copyright 2026-present 650 Industries. All rights reserved.
+
+#if os(iOS) || os(tvOS)
+import Testing
+import UIKit
+
+@testable import ExpoFileSystem
+
+@Suite("Background session handler")
+struct FileSystemBackgroundSessionHandlerTests {
+  @Test
+  @MainActor
+  func testCompletesAtOnceForSessionOfAnotherModule() {
+    let handler = FileSystemBackgroundSessionHandler()
+    var calls = 0
+    handler.application(UIApplication.shared, handleEventsForBackgroundURLSession: "com.example.other-module.background") {
+      calls += 1
+    }
+    #expect(calls == 1)
+  }
+
+  @Test
+  @MainActor
+  func testLegacySingletonCompletesAtOnce() {
+    let handler: UIApplicationDelegate = EXSessionHandler()
+    var calls = 0
+    handler.application?(UIApplication.shared, handleEventsForBackgroundURLSession: "com.example.any.background") {
+      calls += 1
+    }
+    #expect(calls == 1)
+  }
+}
+#endif
